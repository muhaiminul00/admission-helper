# Django's cryptographic signing key. Required in production - never
# reuse the insecure default settings.py falls back to for local dev.
SECRET_KEY=

# False in production.
DEBUG=True

# Comma-separated list of hostnames this deployment answers to.
# Required in production (e.g. your-app.onrender.com). Defaults to
# localhost/127.0.0.1 when DEBUG=True and this is unset.
ALLOWED_HOSTS=

# Comma-separated list of origins allowed to submit cross-site POSTs
# (e.g. https://your-app.onrender.com). Required in production if
# you're behind HTTPS - unset breaks admin/form POSTs in production.
CSRF_TRUSTED_ORIGINS=

# Optional - unset, the app uses local SQLite. Set in production to
# point at PostgreSQL, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Gmail SMTP credentials. With DEBUG=False and both of these set, real
# email is sent via Gmail; otherwise (including all local development)
# email is printed to the console instead. Use a Gmail **app password**,
# not your real account password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional SMTP overrides - only relevant once EMAIL_HOST_USER/
# EMAIL_HOST_PASSWORD are set. Defaults shown are Gmail's own.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# IANA timezone name this deployment's dates/times are calculated in
# (revision due dates, exam reminders, Routine Week boundaries, etc.).
# Optional - defaults to Asia/Dhaka (this app's original admission
# schedule).
# TIME_ZONE=Asia/Dhaka

# Session/CSRF cookie security (Secure flag, HSTS) are enabled
# automatically whenever DEBUG=False - there is no separate on/off
# variable for them. See admission_helper/settings.py's "Security"
# section if you need to tune SECURE_HSTS_SECONDS or disable the
# HTTPS redirect behind a proxy that already terminates TLS
# (SECURE_SSL_REDIRECT, default True when DEBUG=False):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
